SPRING_PROFILES_ACTIVE=dev

PORT=8082
MANAGEMENT_PORT=9082

DB_URL=jdbc:postgresql://localhost:5432/telemed_ia
DB_USERNAME=notifications_app
DB_PASSWORD=change-me

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=3000
DB_STATEMENT_OPTIONS=-c statement_timeout=5000

HTTP_CONNECTION_TIMEOUT=5s
HTTP_KEEP_ALIVE_TIMEOUT=60s
HTTP_MAX_KEEP_ALIVE_REQUESTS=100

# Local SMTP catcher (e.g. Mailpit on 1025). In prod use the real relay
# with MAIL_SMTP_AUTH=true and MAIL_SMTP_STARTTLS=true.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@telemed.local
MAIL_TIME_ZONE=America/Bogota

# HU-03: consumes PasswordRecoveryRequested (exchange identity.events) from RabbitMQ.
# Off unless true; Docker Compose turns it on. Inside the platform network the host is rabbitmq.
NOTIFICATIONS_LISTENER_ENABLED=true
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

# Identity's RS256 public key, the same one identity-api uses (never its private key).
# Docker Compose mounts JWT_PUBLIC_KEY_HOST_FILE; a local run uses JWT_PUBLIC_KEY_FILE or JWT_PUBLIC_KEY.
JWT_ISSUER=telemed-ia-identity-and-access
JWT_PUBLIC_KEY_HOST_FILE=/absolute/path/to/dev-public-key.pem
# JWT_PUBLIC_KEY_FILE=/absolute/path/to/dev-public-key.pem
# JWT_PUBLIC_KEY=REPLACE_WITH_ESCAPED_X509_RSA_PEM

# Service client to ask identity for the patient's e-mail (HU-17). Identity's SERVICE_CLIENTS must list
# notifications:<bcrypt hash of this secret>. Inside the platform network identity is identity-api:8081.
IDENTITY_BASE_URL=http://localhost:8081
IDENTITY_CLIENT_ID=notifications
IDENTITY_CLIENT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
IDENTITY_TIMEOUT=3s
