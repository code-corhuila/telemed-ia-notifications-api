# DEC-018: test mode. Pass it AFTER .env so these values win:
#   docker compose --env-file .env --env-file deploy/mail-test.env -f deploy/compose.yml --profile mail-test up -d
# Every e-mail goes to the Mailpit inbox (http://127.0.0.1:8025); nothing reaches a real mailbox.
# Back to the real relay:
#   docker compose --env-file .env -f deploy/compose.yml up -d
# No secrets here.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
